# ─── Supabase ───────────────────────────────────────────────────────
# Next.js public env vars (prefixed with NEXT_PUBLIC_).
# These are injected at build time and embedded in the client bundle.
# They use the ANON key (public read/write access gated by RLS policies),
# NOT the service_role key — no server-side secret is required for this app.

# Your Supabase project URL (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase anon (public) key (Project Settings → API → anon public)
# Never commit the service_role key here — this app does not need it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side secrets (account recovery) - never shipped to the client.
# The app reads these only in server-only modules; the build fails if they leak.
# The service_role key is in your Supabase dashboard (Project Settings > API keys).
# APP_RECOVERY_PASSPHRASE is a high-entropy secret you keep in your password manager.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
APP_RECOVERY_PASSPHRASE=your-recovery-passphrase

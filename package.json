{
  "name": "money-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "gate:all": "node verification/screenshot-prep/run-gate-all.mjs",
    "test": "vitest run --exclude=**/design-conformance.test.ts",
    "test:scan": "vitest run src/tests/design-conformance.test.ts",
    "gate:types": "tsc --noEmit",
    "gate:select-items": "node verification/screenshot-prep/select-items-check.mjs",
    "gate:card-padding": "node verification/screenshot-prep/card-padding-check.mjs",
    "gate:typography": "vitest run src/tests/typography-conformance.test.ts",
    "gate:dom": "node verification/screenshot-prep/probe-run.mjs",
    "gate:nav": "node verification/screenshot-prep/nav-check.mjs",
    "gate:rules": "node verification/screenshot-prep/gate-rules.mjs",
    "gate:logo-source": "node verification/screenshot-prep/brand-logo-source-check.mjs",
    "gate:popover": "node verification/screenshot-prep/popover-check.mjs",
    "gate:brand": "node verification/screenshot-prep/account-brand-check.mjs",
    "gate:brand:states": "node verification/screenshot-prep/account-brand-states-check.mjs",
    "gate:captures": "node verification/screenshot-prep/capture-desktop.mjs && node verification/screenshot-prep/capture-mobile.mjs && node verification/screenshot-prep/capture-wide.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@supabase/ssr": "^0.12.3",
